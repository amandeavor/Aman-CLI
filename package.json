{
  "name": "@amandeavor/aman-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Your AI workflows, in one place. Organize skills, prompts, and MCP configs with read-only diagnostics.",
  "bin": {
    "aman": "./dist/bin/aman.js",
    "aman-cli": "./dist/bin/aman.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/assets/aman-banner.svg"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc",
    "dev": "tsx src/bin/aman.ts",
    "init": "tsx src/bin/aman.ts init",
    "setup": "tsx src/bin/aman.ts init",
    "browse": "tsx src/bin/aman.ts browse",
    "search": "tsx src/bin/aman.ts search",
    "doctor": "tsx src/bin/aman.ts doctor",
    "start": "tsx src/bin/aman.ts",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "chalk": "^6.0.0",
    "conf": "^15.1.0",
    "fuse.js": "^7.5.0",
    "glob": "^13.0.6",
    "ink": "^7.1.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^5.4.1",
    "meow": "^14.1.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "author": "Aman Intelligence",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amandeavor/aman-cli.git"
  },
  "bugs": {
    "url": "https://github.com/amandeavor/aman-cli/issues"
  },
  "homepage": "https://github.com/amandeavor/aman-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "workflow",
    "cli",
    "assets",
    "mcp",
    "skills",
    "prompts",
    "agentic-coding",
    "developer-tools"
  ]
}
